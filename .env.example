# Environment Variables — Anti-Doomscroll Journal

# ---- Android Signing ----
KEYSTORE_PATH=./android/app/release.keystore
KEYSTORE_ALIAS=antidoomscroll
KEYSTORE_PASSWORD=changeme
KEY_PASSWORD=changeme

# ---- iOS Distribution ----
APPLE_ID=your@apple.id
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
TEAM_ID=XXXXXXXXXX
BUNDLE_ID=com.antidoomscroll.journal

# ---- Landing Page Deployment ----
# For S3:
S3_BUCKET=antidoomscroll-landing
CF_DISTRIBUTION_ID=EXXXXXXXXXX

# ---- Analytics (optional) ----
ANALYTICS_WRITE_KEY=
SENTRY_DSN=

# ---- Build Metadata ----
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
