{
  "name": "AntiDoomscrollJournal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:android:debug": "bash scripts/build-android.sh --variant debug --output-dir dist/android",
    "build:android:release": "bash scripts/build-android.sh --variant release --output-dir dist/android",
    "build:ios:debug": "bash scripts/build-ios.sh --scheme debug --output-dir dist/ios",
    "build:ios:release": "bash scripts/build-ios.sh --scheme release --output-dir dist/ios",
    "release:android": "bash scripts/release-android.sh",
    "release:ios": "bash scripts/release-ios.sh",
    "deploy:landing": "bash scripts/deploy-landing.sh",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@notifee/react-native": "^7.8.2",
    "react-native-background-fetch": "^4.2.1",
    "react-native-mmkv": "^2.12.2",
    "react-native-quick-sqlite": "^8.0.6",
    "react-native-reanimated": "^3.8.1",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-screens": "^3.30.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-svg": "^15.2.0",
    "lottie-react-native": "^6.7.2",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-device-info": "^11.1.0",
    "react-native-permissions": "^4.1.5",
    "@react-native-community/datetimepicker": "^7.7.0",
    "zustand": "^4.5.2",
    "uuid": "^9.0.1",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.73.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-config": "^0.80.0",
    "prettier": "2.8.8",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "react-native"
  },
  "engines": {
    "node": ">=18"
  }
}
